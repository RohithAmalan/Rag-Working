# =============================================================================
# RAG Application — Backend Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit your actual .env file to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="RAG Application"
ENVIRONMENT="development"       # development | production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Wildcard (*) is NOT supported when credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── LLM ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (optional — only needed for OpenAI-backed chains)
OPENAI_API_KEY=

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local: mongodb://root:<pass>@localhost:27017/?authSource=admin
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=rag_db
DOCUMENTS_COLLECTION=documents
CHUNKS_COLLECTION=chunks
ALLOW_START_WITHOUT_MONGO=true   # set false in production

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# ── MinIO (S3-compatible object storage) ──────────────────────────────────────
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key       # never use default 'minioadmin' in production
MINIO_SECRET_KEY=your_minio_secret_key       # never use default 'minioadmin' in production
MINIO_BUCKET=rag-files
MINIO_SECURE=false                            # set true when using HTTPS MinIO

# ── Keycloak SSO ──────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=rag-realm
KEYCLOAK_CLIENT_ID=rag-app

# ── Legacy Auth (fallback when Keycloak is not configured) ────────────────────
# Store user credentials as bcrypt hashes, never plaintext.
# Generate a hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# Example (do NOT use these hashes in production — generate your own):
# LEGACY_USERS={"admin":"$2b$12$<your_admin_hash>","demo":"$2b$12$<your_demo_hash>"}
LEGACY_USERS=

# ── n8n Workflow Automation ───────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/rag-event

# ── LangGraph ─────────────────────────────────────────────────────────────────
LANGGRAPH_WORKFLOW_MODE=multi_agent   # basic | advanced | multi_agent
