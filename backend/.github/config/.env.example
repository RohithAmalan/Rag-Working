# RAG Backend Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git (it contains secrets)

# ============================================================
# MongoDB Configuration
# ============================================================

# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://rag_user:your_password_here@cluster0.abc123.mongodb.net/?retryWrites=true&w=majority

# Database name (will be created if doesn't exist)
DATABASE_NAME=rag_db

# Collection names
DOCUMENTS_COLLECTION=documents
CHUNKS_COLLECTION=chunks

# MongoDB connection pool settings
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# ============================================================
# Groq LLM Configuration
# ============================================================

# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here

# LLM model (default: llama-3.1-8b-instant)
# Other options: mixtral-8x7b-32768, gemma-7b-it
GROQ_MODEL=llama-3.1-8b-instant

# ============================================================
# Embedding Configuration
# ============================================================

# Embedding model (default: all-MiniLM-L6-v2)
# This generates 384-dimensional vectors
# Other options: sentence-transformers/all-MiniLM-L12-v2 (more accurate but slower)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding dimensions (do NOT change unless using different model)
EMBEDDING_DIMENSION=384

# Batch size for embedding generation (adjust based on RAM)
# Larger = faster but uses more memory
EMBEDDING_BATCH_SIZE=32

# ============================================================
# File Processing Configuration
# ============================================================

# Maximum file size in MB (per file)
MAX_FILE_SIZE_MB=100

# Directory for uploaded files (create if doesn't exist)
UPLOAD_DIR=app/uploads/files

# Chunk size for text splitting (in characters)
CHUNK_SIZE=500

# Overlap between consecutive chunks (in characters)
CHUNK_OVERLAP=50

# ============================================================
# Vector Search Configuration
# ============================================================

# Number of chunks to retrieve by default
TOP_K_DEFAULT=5

# Minimum similarity score (0-1) to include in results
MIN_SIMILARITY_SCORE=0.0

# Whether to prioritize primary sources (CSV/XLSX) over secondary (PDF)
PRIORITIZE_PRIMARY_SOURCES=True

# ============================================================
# FastAPI Configuration
# ============================================================

# Environment: development, staging, production
ENV=development

# Debug mode (NEVER True in production)
DEBUG=False

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# CORS origins (comma-separated)
# For development: *
# For production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=*

# API title and version
API_TITLE=RAG Backend API
API_VERSION=1.0.0

# ============================================================
# Server Configuration
# ============================================================

# Server host (0.0.0.0 = accessible from any IP)
SERVER_HOST=0.0.0.0

# Server port
SERVER_PORT=8000

# Number of worker processes (for production)
# 0 = auto-detect based on CPU cores
WORKERS=1

# ============================================================
# Rate Limiting (Optional)
# ============================================================

# Enable rate limiting
ENABLE_RATE_LIMITING=False

# Requests per minute
RATE_LIMIT_PER_MINUTE=100

# ============================================================
# Logging Configuration
# ============================================================

# Log format: text or json
LOG_FORMAT=text

# Application name for logs
APP_NAME=rag-backend

# ============================================================
# Performance Configuration
# ============================================================

# Cache embedding model in memory
CACHE_EMBEDDING_MODEL=True

# Timeout for MongoDB queries (seconds)
MONGODB_QUERY_TIMEOUT=30

# Timeout for LLM API calls (seconds)
LLM_TIMEOUT=30

# ============================================================
# Security Configuration (Production)
# ============================================================

# Secret key for sessions (change for production)
SECRET_KEY=your-secret-key-change-this-in-production

# JWT settings (if using authentication)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================
# Optional: Third-party Services
# ============================================================

# Sentry error tracking (optional)
# SENTRY_DSN=https://...@sentry.io/...

# New Relic monitoring (optional)
# NEW_RELIC_LICENSE_KEY=...

# ============================================================
# Development Only
# ============================================================

# Auto-reload on code changes
AUTO_RELOAD=True

# Run API documentation
# Swagger UI: http://localhost:8000/docs
# ReDoc: http://localhost:8000/redoc
ENABLE_DOCS=True

# ============================================================
# Notes
# ============================================================
# 
# 1. MongoDB Atlas Setup:
#    - Create account at https://cloud.mongodb.com
#    - Create M10+ cluster for production
#    - Create database user with strong password
#    - Add your IP to whitelist
#    - Copy connection string to MONGODB_URI
#
# 2. Groq API Key:
#    - Sign up at https://console.groq.com
#    - Create API key
#    - Add to GROQ_API_KEY
#
# 3. Directory Structure:
#    - Create UPLOAD_DIR if it doesn't exist: mkdir -p app/uploads/files
#    - Ensure write permissions: chmod 755 app/uploads
#
# 4. Production Checklist:
#    - Set DEBUG=False
#    - Set ENV=production
#    - Use strong SECRET_KEY
#    - Set ALLOWED_ORIGINS to specific domains
#    - Enable SSL/TLS
#    - Set up monitoring/logging
#    - Configure backups
#
# ============================================================
